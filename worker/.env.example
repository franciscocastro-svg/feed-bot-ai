# Required server-side values. Fill only in the VPS secret environment.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Optional providers and tuning.
GROQ_API_KEY=
XAI_API_KEY=
CUT_TRANSCRIPTION_PROVIDERS=groq,gemini
CUT_ANALYSIS_PROVIDERS=gemini,xai
CUT_SUBTITLE_LEAD_MS=80
GEMINI_TEXT_MODEL=
GEMINI_TRANSCRIBE_MODEL=
GEMINI_CUT_ANALYSIS_MODEL=
GEMINI_FACE_MODEL=
GROQ_WHISPER_MODEL=
XAI_BASE_URL=
XAI_CUT_MODEL=

# Optional real-photo provider for editorial carousels. If the key is absent,
# carousels remain fully functional with text-only slides.
CAROUSEL_IMAGE_PROVIDER=pixabay
# Cascata de provedores (tem prioridade sobre CAROUSEL_IMAGE_PROVIDER).
# Valores: serpapi, pixabay, openverse, google, bing — ex.: serpapi,pixabay,openverse
CAROUSEL_IMAGE_PROVIDERS=serpapi,pixabay,openverse
# Google Imagens via SerpApi (somente servidor; nunca no frontend).
SERPAPI_API_KEY=
PIXABAY_API_KEY=
# Google Programmable Search (imagens). rights vazio = sem filtro de licença (uso por conta e risco do cliente).
GOOGLE_IMAGE_API_KEY=
GOOGLE_IMAGE_CX=
GOOGLE_IMAGE_RIGHTS=cc_publicdomain|cc_attribute|cc_sharealike
# Bing Image Search (Azure). license vazio = sem filtro de licença.
BING_IMAGE_API_KEY=
BING_IMAGE_LICENSE=ShareCommercially
CAROUSEL_IMAGE_MAX_PER_CAROUSEL=1


# Optional YouTube extraction configuration.
YT_COOKIES_FILE=
YT_DLP_REMOTE_COMPONENTS=
YT_DLP_EXTRACTOR_ARGS=
YT_DLP_USER_AGENT=

# Process identity is normally supplied by ecosystem.config.cjs.
WORKER_ID=
WORKER_QUEUES=
WORKER_VERSION=
